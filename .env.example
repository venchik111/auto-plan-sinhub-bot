# Telegram BotFather token (нужен только для старой Telegram-версии)
TELEGRAM_BOT_TOKEN=

# OpenCode CLI. The CLI owns the OpenCode session and credentials.
LLM_PROVIDER=opencode
OPENCODE_BIN=opencode
OPENCODE_AGENT=planner
OPENCODE_MODELS=opencode/muse-spark-1.3-contributor-free,opencode/mimo-v2.5-free
OPENCODE_TIMEOUT_SECONDS=180
# Optional working directory for the OpenCode project config and agents.
OPENCODE_DIR=./opencode

# Alternative: OpenRouter free models (HTTP adapter).
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Sheets
GOOGLE_SPREADSHEET_ID=1k_HlqX0fUZFUckbMQfXcyWgQNwxLyKn2AktiORTPwIw
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service-account.json

# Skyeng schedule session (created by: python -m app.skyeng_login)
SKYENG_STORAGE_STATE_FILE=./credentials/skyeng-storage.json

# Local state
DATABASE_PATH=./bot.sqlite3
APP_TIMEZONE=Europe/Moscow

# Curator review of freshmen plans (page /curator). Both are required to enable it.
# The service account needs read access to this spreadsheet. Analysis uses the OpenCode CLI.
FRESHMEN_SPREADSHEET_ID=
CURATOR_PASSWORD=
OPENCODE_REVIEW_AGENT=reviewer
OPENCODE_REFLECTION_AGENT=reflection
# Optional comma-separated allowlist for the curator page.
CURATOR_STUDENTS=

# Admin approval of student account registrations (/admin).
# If empty, the existing CURATOR_PASSWORD is used for local compatibility.
ADMIN_PASSWORD=
